# Set these in your host's environment settings. The scripts do not auto-load this file.
# Replace the attached script's existing webhook with a newly created Discord webhook.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_WITH_ID/REPLACE_WITH_TOKEN
DISCORD_USER_ID=
PING_EVERYONE=true
CHECK_EVERY=30
PRICE_ALERT_STATE_FILE=/var/data/price-alert/state.json
TEST_ALERT=false
